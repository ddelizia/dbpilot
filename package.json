{
  "name": "db-setup-cli",
  "version": "1.0.0",
  "description": "TUI CLI for PostgreSQL and Typesense management using React and Ink",
  "main": "dist/cli.js",
  "bin": {
    "db-setup": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "start": "tsx src/cli.tsx",
    "build": "tsc && chmod +x dist/cli.js",
    "build:cli": "tsc && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "ink": "^5.0.1",
    "ink-select-input": "^5.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "typesense": "^1.8.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.3",
    "tsx": "^4.16.0",
    "typescript": "^5.5.2"
  }
}
